# Leave real values in your local .env or secure environment settings.
# Never commit .env, OAuth files, or a real database.
HOST=127.0.0.1
PORT=3000
NUKMIRIS_MODE=availability
# Set NUKMIRIS_MODE=booking only after following BOOKING_CHECKPOINT.md.
# Optional customer-confirmed rescheduling/cancellation; see MANAGEMENT_CHECKPOINT.md.
NUKMIRIS_ENABLE_MANAGEMENT=false
NUKMIRIS_ROUTING_MODE=receiving_number
NUKMIRIS_BUSINESS_ID=juanita-nails
NUKMIRIS_SETTINGS_PATH=config/juanita.example.json
NUKMIRIS_LOOKAHEAD_DAYS=14

# Must already exist and contain the Phase 6A.3 tables.
# Relative paths resolve from backend/, regardless of the launch directory.
NUKMIRIS_DB_PATH=./data/nukmiris-sessions.sqlite

WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v26.0
META_APP_SECRET=

# Point to your EXISTING local Google Desktop OAuth credentials file.
# Absolute paths are supported; relative paths resolve from backend/.
GOOGLE_OAUTH_CREDENTIALS_PATH=
GOOGLE_OAUTH_TOKEN_PATH=.local/google-token.json
# Separate authorization for the optional new-booking mode; keep the read-only file.
GOOGLE_BOOKING_TOKEN_PATH=.local/google-booking-token.json

# Set this after calendars:list. Use the exact named calendar ID, never "primary".
GOOGLE_CALENDAR_ID=
