# Leave real values in your local .env or secure environment settings.
# Never commit .env, OAuth files, or a real database.
HOST=127.0.0.1
PORT=3000

# Must already exist and contain the Phase 6A.3 tables.
# Relative paths resolve from backend/, regardless of the launch directory.
NUKMIRIS_DB_PATH=./data/nukmiris-sessions.sqlite

WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v26.0

# Google Calendar is disabled. This baseline does not require Google credentials.
