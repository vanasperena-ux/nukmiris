# PROPOSED WP2-L contract only; today's WP1 package does not load this file.
# No secret values. Future demo:prepare generates private local credentials/keys.
NUKMIRIS_MODE=synthetic-local
NUKMIRIS_BIND=127.0.0.1
NUKMIRIS_PORT=3077
NUKMIRIS_DATABASE_HOST=127.0.0.1
NUKMIRIS_DATABASE_PORT=55432
NUKMIRIS_DATABASE_NAME=nukmiris_vnext_demo
NUKMIRIS_DATABASE_USER=nukmiris_demo_runtime
NUKMIRIS_LOCAL_STATE_DIR=./.local-demo
NUKMIRIS_LOCAL_DATABASE_SECRET_FILE=./.local-demo/secrets/db-password.txt
NUKMIRIS_LOCAL_ARCHIVE_SECRET_FILE=./.local-demo/secrets/archive-key.txt
NUKMIRIS_REMINDERS_MODE=off
NUKMIRIS_ALLOW_EXTERNAL_PROVIDERS=false
