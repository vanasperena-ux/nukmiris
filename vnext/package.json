    "test:conditions": "npm run build && node scripts/run-tests.mjs conditions",
    "check:scope": "node scripts/check-scope.mjs"
  },
  "dependencies": { "pg": "8.16.3" },
  "devDependencies": { "@types/node": "24.10.0", "@types/pg": "8.15.5", "typescript": "5.9.3" }
}
